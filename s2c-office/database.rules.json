{
  "rules": {
    "lobbies": {
      "$code": {
        "meta": {
          ".read": "auth != null",
          ".write": "auth != null && $code.matches(/^[A-Z0-9]{6}$/) && ((!data.exists() && newData.child('host').val() === auth.uid) || (data.child('host').val() === auth.uid && newData.child('host').val() === auth.uid))",
          ".validate": "newData.hasChildren(['host', 'roster'])",
          "roster": {
            "$role": {
              ".validate": "$role.matches(/^(mp|ceo|cfo|coo|qm|gm)$/) && newData.isString() && newData.val().length <= 20"
            }
          }
        },
        "claims": {
          ".read": "auth != null",
          "$role": {
            ".write": "auth != null && root.child('lobbies').child($code).child('meta').exists() && ((!data.exists() && newData.val() === auth.uid) || data.val() === auth.uid)",
            ".validate": "newData.isString() && $role.matches(/^(mp|ceo|cfo|coo|qm|gm)$/) && ($role !== 'mp' || newData.val() === root.child('lobbies').child($code).child('meta/host').val())"
          }
        },
        "presence": {
          ".read": "auth != null && root.child('lobbies').child($code).child('meta').exists()",
          "$uid": {
            ".write": "auth != null && auth.uid === $uid && root.child('lobbies').child($code).child('meta').exists()",
            ".validate": "!newData.child('r').exists() || newData.child('r').val() === 'agent' || root.child('lobbies').child($code).child('claims').child(newData.child('r').val()).val() === $uid"
          }
        },
        "inbox": {
          "$uid": {
            ".read": "auth != null && auth.uid === $uid",
            ".write": "auth != null && auth.uid === $uid",
            "$msg": {
              ".write": "auth != null && !data.exists() && newData.child('from').val() === auth.uid",
              ".validate": "newData.hasChildren(['from', 'topic', 'data'])"
            }
          }
        }
      }
    }
  }
}
